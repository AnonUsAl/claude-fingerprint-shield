{
  "manifest_version": 3,
  "name": "Claude 低风险指纹",
  "version": "1.0.0",
  "description": "访问 Claude 相关站点时，把时区 / 语言 / 中文字体 / WebRTC / Intl 等区域指纹伪装成非中国大陆环境，降低「中国用户风险分」。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://claude.ai/*",
    "*://*.claude.ai/*",
    "*://claude.com/*",
    "*://*.claude.com/*",
    "*://anthropic.com/*",
    "*://*.anthropic.com/*",
    "*://fuck-claude.vercel.app/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Claude 低风险指纹",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://claude.com/*",
        "*://*.claude.com/*",
        "*://anthropic.com/*",
        "*://*.anthropic.com/*",
        "*://fuck-claude.vercel.app/*"
      ],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://claude.com/*",
        "*://*.claude.com/*",
        "*://anthropic.com/*",
        "*://*.anthropic.com/*",
        "*://fuck-claude.vercel.app/*"
      ],
      "js": ["src/spoof.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
